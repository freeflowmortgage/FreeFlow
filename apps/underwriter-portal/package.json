{
  "name": "web",
  "version": "7.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/verify-production-routes.mjs",
    "start": "node scripts/start.mjs",
    "start:document-pull-worker": "tsx scripts/document-pull-worker.ts",
    "start:encompass-sync-worker": "tsx scripts/encompass-sync-worker.ts",
    "lint": "next lint",
    "test": "node --test scripts/*.test.mjs && tsx --test src/server/auth/*.test.ts src/server/audit/*.test.ts src/server/http/*.test.ts src/server/income/*.test.ts src/server/integrations/encompass/*.test.ts src/server/observability/*.test.ts",
    "certify:encompass": "tsx scripts/encompass-certification.ts",
    "certify:standalone-exports": "tsx scripts/standalone-export-evidence.ts",
    "test:database-isolation": "tsx --test src/server/database/*.integration.test.ts",
    "validate:production-config": "node scripts/production-config.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1141.0",
    "@mortgage-pos/database": "workspace:*",
    "@mortgage-pos/encompass-connector-contract": "workspace:*",
    "@mortgage-pos/mortgage-engine": "workspace:*",
    "@mortgage-pos/ui": "workspace:*",
    "@prisma/client": "^5.22.0",
    "@stripe/stripe-js": "^3.5.0",
    "@supabase/supabase-js": "^2.117.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.378.0",
    "next": "15.5.29",
    "pdfkit": "^0.15.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^15.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
