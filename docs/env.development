# ==============================================================================
# FREEFLOW B2B MONOREPO - LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Save this file in your root monorepo directory as '.env.development'
# For local dev execution, duplicate this to '.env' at the root: cp .env.development .env
# Make sure to boot up local docker-compose services before building the project.
# ==============================================================================

# 1. System Runtime Node Settings
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 2. B2B Decoupled PostgreSQL Connection Strings (Matches Local Postgres Container)
# User: postgres | Password: localpassword123 | Database: freeflow_b2b_dev | Port: 5432
DATABASE_URL="postgresql://postgres:localpassword123@localhost:5432/freeflow_b2b_dev?schema=public"
DIRECT_URL="postgresql://postgres:localpassword123@localhost:5432/freeflow_b2b_dev?schema=public"

# 3. Redis Volatile Cache & Task Queue (Matches Local Redis Container)
# Used to queue background Ellie Mae Encompass eFolder operations
REDIS_URL="redis://localhost:6379"

# 4. Local S3 / MinIO Private Document Storage (Matches Local MinIO Container)
# Used to stage files temporarily during in-memory slicing checks
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="localminioadmin"
AWS_SECRET_ACCESS_KEY="localminiopassword123"
AWS_S3_ENDPOINT="http://localhost:9000"
AWS_S3_BUCKET_NAME="freeflow-document-intake"

# 5. Cryptographic & Security Tokens
# Used to verify SHA-256 document signatures for zero-retention deduplication
CRYPTO_SALT_SECRET="7a6d8f8d6e3e5b3c4f9a0c2e1f4b8d2c"
JWT_SECRET="9b2c8d2c4f9a0c2e1f4b8d2c7a6d8f8d"
NEXTAUTH_SECRET="e1f4b8d2c7a6d8f8d9b2c8d2c4f9a0c2"

# 6. Third-Party Webhook Integrations
# Stripe test keys used to audit transactional volumetric calculations
STRIPE_SECRET_KEY="sk_test_mock_stripe_secret_key_123"
STRIPE_WEBHOOK_SECRET="whsec_mock_webhook_secret_123"

# Encompass REST Developer Portal (Ellie Mae Mock Gateway credentials)

# 7. Volumetric Transaction Fee Baselines (Tier-Based Default settings)
NEXT_PUBLIC_WAGE_EARNER_FEE_CENTS=800     # Tier 1: $8.00 standard physical document W-2 run
NEXT_PUBLIC_SINGLE_PROP_FEE_CENTS=2500    # Tier 2: $25.00 single-entity Schedule C/E rental parse
NEXT_PUBLIC_MULTI_ENTITY_FEE_CENTS=4500   # Tier 3: $45.00 complex S-Corp/Partnership tax analysis
