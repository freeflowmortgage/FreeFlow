datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  SUPER_ADMIN
  BROKER_OWNER // Can manage tenant configurations, view billing logs, and clear overrides
  LOAN_OFFICER // Sales/LO role - strictly READ-ONLY on underwriter-finalized audits
  PROCESSOR // Collaborative review role, can edit fields and trigger manual conditions
  UNDERWRITER // Risk owner - can edit audits, clear warnings, and trigger Encompass writebacks
  BORROWER // Individual filling out 1003 details during intake
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  DOCS_UPLOADED // Raw documents received in eFolder, OCR parsing triggered
  IN_QA_REVIEW // Undergoing verification and coordinate validation inside splitview UI
  VERIFIED // Income calculations locked and verified by underwriter
  EXPORTED_TO_LOS // Calculations successfully synchronized back to Encompass REST fields
  ARCHIVED
}

enum ConditionStatus {
  OPEN
  SUBMITTED
  CLEARED
  REJECTED
}

enum EntityType {
  SCHEDULE_C // Sole Proprietor (Form 1040 Line 31)
  SCHEDULE_E_PART_1 // Rental Properties (Form 1040 Schedule E Page 1)
  SCHEDULE_E_PART_2 // Partnership/S-Corp K-1s (Form 1040 Schedule E Page 2)
  FORM_1120S // S-Corporation Returns
  FORM_1065 // Partnership Returns
  FORM_1120 // C-Corporation Returns
}

enum BillingTier {
  STANDARD // $8.00 Tier: Standard wages (W-2s, Paystubs, SSI, Pension)
  COMPLEX // $25.00 / $45.00 Tier: Extended tax returns, Schedule C/E portfolios, Corporate S-Corps
}

enum TrendingAnalysisResult {
  CONVENTIONAL_STABLE_OR_INCREASING // Standard 24-Month Average qualifying income
  CONVENTIONAL_DECLINING // Declining trend: Restricted strictly to most recent 12-Month Average
  FHA_STABLE_OR_INCREASING // FHA 24-Month Average calculation
  FHA_DECLINE_WARNING // Decline of 5% to 20%: Locked to most recent 12-Month Average
  FHA_CRITICAL_DECLINE // Decline > 20%: Disqualification warning issued
  VA_STABLE_OR_INCREASING // VA standard 24-Month calculation
  VA_DECLINING // VA lower 12-Month average with conservative underwriter overlay
  USDA_STABLE_OR_INCREASING // USDA standard note repayment calculation (allowing addbacks)
  USDA_DECLINING // USDA declining trend: Lower 12-Month average applied
  SINGLE_YEAR // Restricted to standard single-year returns (e.g. business > 5 years)
  INSUFFICIENT_DATA // Missing comparative historical files
}

// =============================================================================
// DATABASE MODELS (Income Point-Solution Focus Only)
// =============================================================================

// 1. TENANTS (Brokerages / Lenders using the Income Tool)
model Tenant {
  id                  String  @id @default(uuid()) @db.Uuid
  companyName         String  @db.VarChar(255)
  nmlsId              String? @db.VarChar(50)
  primaryContactEmail String  @db.VarChar(255)
  isActive            Boolean @default(true)

  // Stripe Metered Billing Integrations
  stripeCustomerId String? @unique @db.VarChar(255)
  isBillingActive  Boolean @default(true) // Accounts are suspended if pay methods fail

  // Relations
  users               User[]
  configurations      TenantConfiguration?
  loanApplications    LoanApplication[]
  billingLedgers      TenantBillingLedger[]
  auditEvents         AuditEvent[]
  apiIdempotencyKeys  ApiIdempotencyKey[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("tenants")
}

// 2. TENANT CONFIGURATIONS (Feature Flags & Encompass Keys)
model TenantConfiguration {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Feature Toggles (Specific to Income Point-Solution)
  enable1084Ocr         Boolean @default(true) // Standard Form 1084 scanning active
  enableEncompassSync   Boolean @default(true) // Active Encompass REST connection
  enableUshdaValidation Boolean @default(true) // USDA dual-track math activated
  enableAppraisalReview Boolean @default(true) // URAR 1004 coordinate QA workspace

  // Encrypted API Keys for Ellie Mae Developer Connect and Stripe
  encompassClientId   String? @db.VarChar(255)
  encompassInstanceId String? @db.VarChar(255)
  stripeWebhookSecret String? @db.VarChar(255)

  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("tenant_configurations")
}

// 3. USERS (Underwriters, Processors, Sales LOs, Borrowers)
model User {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email        String   @unique @db.VarChar(255)
  oidcSubject  String?  @unique @db.VarChar(255)
  isActive     Boolean  @default(true)
  passwordHash String?  @db.VarChar(255)
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  role         UserRole @default(UNDERWRITER)
  nmlsNumber   String?  @db.VarChar(50)

  // Audit Relations
  verifiedAudits          Form1084Audit[]       @relation("VerifiedByUser")
  verifiedAppraisals      AppraisalAudit[]      @relation("AppraisalVerifiedByUser")
  clearedAppraisalActions AppraisalActionItem[] @relation("ActionItemClearedByUser")
  auditEvents             AuditEvent[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([tenantId, id])
  @@index([tenantId, email])
  @@map("users")
}

// 4. LOAN APPLICATIONS (Active Loan Casefiles)
model LoanApplication {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Borrowing Meta
  primaryBorrowerName  String            @db.VarChar(255)
  primaryBorrowerEmail String            @db.VarChar(255)
  status               ApplicationStatus @default(DRAFT)
  encompassGuid        String?           @db.VarChar(255) // Matches active loan in Encompass eFolder
  version              Int               @default(1)

  // Relations
  documents        LoanDocument[]
  ocrDiffHistories OcrDiffHistory[]
  form1084Audits   Form1084Audit[]
  appraisalAudits  AppraisalAudit[]
  conditions       LoanCondition[]
  billingLedgers   TenantBillingLedger[]
  auditEvents      AuditEvent[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([tenantId, id])
  @@unique([tenantId, encompassGuid])
  @@index([tenantId])
  @@map("loan_applications")
}

// 5. LOAN DOCUMENTS (Tax Returns, W-2s, Paystubs in secure storage)
model LoanDocument {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  loanId          String          @db.Uuid
  loanApplication LoanApplication @relation(fields: [tenantId, loanId], references: [tenantId, id], onDelete: Cascade)

  fileType           String   @db.VarChar(100) // e.g. "application/pdf"
  documentCategory   String   @db.VarChar(100) // "TAX_RETURN_1040", "W2_WAGE", "PAYSTUB", "SSI_AWARD"
  sourceAttachmentId String?  @db.VarChar(255) // Encompass attachment ID, never an object key
  sourceContentHash  String?  @db.Char(64) // SHA-256 of bytes held only in memory
  sourcePageCount    Int?
  parserVersion      String?  @db.VarChar(100)
  ocrConfidence      Decimal? @db.Decimal(5, 2) // Aggregate confidence only; no OCR text or payload

  uploadedAt DateTime @default(now()) @db.Timestamptz

  // Relations
  ocrDiffHistories   OcrDiffHistory[]
  resolvedConditions LoanCondition[]  @relation("ResolvedDocument")

  @@unique([tenantId, id])
  @@unique([tenantId, loanId, id])
  @@index([tenantId, loanId])
  @@map("loan_documents")
}

// 6. OCR DIFFERENTIATION LOGS (Traceability & Underwriter Edits)
model OcrDiffHistory {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  loanId          String          @db.Uuid
  loanApplication LoanApplication @relation(fields: [tenantId, loanId], references: [tenantId, id], onDelete: Cascade)
  documentId      String          @db.Uuid
  loanDocument    LoanDocument    @relation(fields: [tenantId, loanId, documentId], references: [tenantId, loanId, id], onDelete: Cascade)

  // Tracking details: values are represented only by SHA-256 evidence hashes.
  fieldName         String   @db.VarChar(100) // e.g. "Schedule C Line 31 Net Profit"
  previousValueHash String?  @db.Char(64)
  newValueHash      String?  @db.Char(64)
  isOverridden      Boolean  @default(false)
  confidenceScore   Decimal  @db.Decimal(5, 2)
  verifiedAt        DateTime @default(now()) @db.Timestamptz

  @@index([tenantId, loanId])
  @@map("ocr_diff_histories")
}

// 7. FORM 1084 AUDITS (Mathematical & Compliance-Grade Outputs)
model Form1084Audit {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  loanId          String          @db.Uuid
  loanApplication LoanApplication @relation(fields: [tenantId, loanId], references: [tenantId, id], onDelete: Cascade)

  entityType     EntityType             @default(SCHEDULE_C)
  businessName   String?                @db.VarChar(255)
  yearsAnalyzed  Int[] // e.g. [2025, 2024]
  trendingResult TrendingAnalysisResult @default(CONVENTIONAL_STABLE_OR_INCREASING)

  // Key Final Variables
  totalAnnualCashFlow     Decimal @db.Decimal(12, 2)
  qualifyingMonthlyIncome Decimal @db.Decimal(12, 2)

  // Allowlisted calculation provenance only; raw request/OCR/override payloads
  // belong neither here nor in any other FreeFlow-managed store.
  calculationSchemaVersion String @default("legacy-unknown") @db.VarChar(100)
  calculationSource        String @default("legacy-unknown") @db.VarChar(100)

  // Liquidity and Risk Parameters (Schedule L check for Corporations)
  quickRatioComputed  Decimal? @db.Decimal(6, 2)
  passesLiquidityTest Boolean?

  // Verification Checks (insulates lenders from blind calculations)
  isHumanVerified  Boolean   @default(false)
  verifiedAt       DateTime? @db.Timestamptz
  verifiedByUserId String?   @db.Uuid
  verifiedByUser   User?     @relation("VerifiedByUser", fields: [tenantId, verifiedByUserId], references: [tenantId, id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([tenantId, loanId, entityType])
  @@map("form_1084_audits")
}

// 8. IMMUTABLE AUDIT EVENTS (calculation, approval, and override evidence)
//
// This table intentionally stores only identifiers, version metadata, bounded
// reason fields, and hashes. It must never contain PDFs, OCR text, raw request
// bodies, borrower identifiers, or provider secrets. The database migration
// grants INSERT/SELECT only and rejects every UPDATE/DELETE attempt.
model AuditEvent {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  loanId          String          @db.Uuid
  loanApplication LoanApplication @relation(fields: [tenantId, loanId], references: [tenantId, id], onDelete: Restrict)
  actorUserId     String          @db.Uuid
  actorUser       User            @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: Restrict)

  action              String   @db.VarChar(100)
  entityType          String   @db.VarChar(100)
  entityId            String   @db.Uuid
  expectedLoanVersion Int
  reasonCode          String   @db.VarChar(100)
  reasonNarrative     String?  @db.VarChar(500)
  ruleVersion         String   @db.VarChar(100)
  schemaVersion       String   @db.VarChar(100)
  requestId           String   @db.VarChar(100)
  resultHash          String   @db.Char(64)
  previousEventHash   String?  @db.Char(64)
  eventHash           String   @unique @db.Char(64)
  occurredAt          DateTime @default(now()) @db.Timestamptz

  @@index([tenantId, occurredAt, id])
  @@index([tenantId, loanId, occurredAt, id])
  @@index([tenantId, requestId])
  @@map("audit_events")
}

// Mutation replay protection. Stores only hashes, status, and a safe
// identifier reference. Never persist request bodies, documents, or PII.
model ApiIdempotencyKey {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  operation          String   @db.VarChar(100)
  key                String   @db.VarChar(128)
  requestHash        String   @db.Char(64)
  responseCode       Int
  responseReference  String   @db.VarChar(512)
  expiresAt          DateTime @db.Timestamptz
  createdAt          DateTime @default(now()) @db.Timestamptz

  @@unique([tenantId, operation, key])
  @@index([tenantId, expiresAt])
  @@map("api_idempotency_keys")
}

// 9. LOAN CONDITIONS (Encompass Checklist Integration)
model LoanCondition {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  loanId          String          @db.Uuid
  loanApplication LoanApplication @relation(fields: [tenantId, loanId], references: [tenantId, id], onDelete: Cascade)

  title       String          @db.VarChar(255) // e.g. "Verify 3-Year Continuation proof on Child Support"
  description String          @db.Text
  category    String          @db.VarChar(100) // "INCOME", "ASSETS", "CREDIT"
  status      ConditionStatus @default(OPEN)

  // Compliance Routing Pointers
  generatedByRule  String?       @db.VarChar(150) // The specific mathematical rule that triggered this card
  requiredDocType  String?       @db.VarChar(100) // e.g., "IHSS_STATE_AGREEMENT" or "CHILD_SUPPORT_DECREE"
  resolvedDocId    String?       @db.Uuid // Document ID attached that successfully cleared this block
  resolvedDocument LoanDocument? @relation("ResolvedDocument", fields: [tenantId, loanId, resolvedDocId], references: [tenantId, loanId, id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([tenantId, loanId])
  @@map("loan_conditions")
}

// 9. TENANT BILLING LEDGERS (Zero-Data-Retention Exemption and Metering)
model TenantBillingLedger {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loanId          String          @db.Uuid
  loanApplication LoanApplication @relation(fields: [tenantId, loanId], references: [tenantId, id], onDelete: Restrict)

  // Cryptographic Signature Vault (Enables recalculations for $0.00 without storing files/PII)
  documentHashList String[] // List of SHA-256 string hashes representing uploaded documents

  activeTier     BillingTier @default(STANDARD)
  amountCents    Int // Metered charge in cents (e.g. 800 for $8.00 W-2, 4500 for $45.00 Corp returns)
  stripeChargeId String?     @db.VarChar(255)
  isBilled       Boolean     @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([tenantId, loanId])
  @@index([createdAt])
  @@map("tenant_billing_ledgers")
}

enum HousingProgram {
  CONVENTIONAL
  FHA
  VA
  USDA
}

enum PropertyType {
  SINGLE_FAMILY
  CONDO
  MULTI_FAMILY
  MANUFACTURED
}

enum OwnershipType {
  FEE_SIMPLE
  LEASEHOLD
}

enum ActionCategory {
  REPAIR
  INSPECTION
  ADMIN
  CRITICAL_DISCREPANCY
}

enum RuleSeverity {
  CRITICAL_ERROR
  WARNING
  COMPLIANCE_INFO
}

enum AuthoritySource {
  FHA_HUD_4000_1
  VA_PAM_26_7_CH12
  FANNIE_MAE_SEL_GUIDE
  COMPLIANCE_GENERAL
}

model AppraisalAudit {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  loanId          String          @db.Uuid
  loanApplication LoanApplication @relation(fields: [tenantId, loanId], references: [tenantId, id], onDelete: Cascade)

  caseNumber              String        @db.VarChar(100)
  intendedUse             String        @db.Text
  highestAndBestUse       Boolean       @default(true)
  ownershipType           OwnershipType @default(FEE_SIMPLE)
  remainingLeaseTermYears Int?
  loanMaturityDate        DateTime      @db.Date
  yearBuilt               Int

  propertyType                      PropertyType @default(SINGLE_FAMILY)
  isManufacturedHousing             Boolean      @default(false)
  hudCertificationPlatesPresent     Boolean      @default(false)
  hudDataPlatePresent               Boolean      @default(false)
  hasFoundationEngineersCertificate Boolean      @default(false)

  atticInspected                   Boolean  @default(false)
  crawlspaceInspected              Boolean  @default(false)
  utilitiesAreActive               Boolean  @default(true)
  septicWellVisualInspectionNoted  Boolean  @default(true)
  peelingPaintDetected             Boolean  @default(false)
  termiteActiveInfestationDetected Boolean  @default(false)
  wellWaterPotabilityTestCleared   Boolean?

  neighborhoodTrend             String  @db.VarChar(50)
  mcMedianPriceCurrentQuarter   Decimal @db.Decimal(12, 2)
  mcMedianPricePriorYearQuarter Decimal @db.Decimal(12, 2)
  mcMonthsSupplyCurrentQuarter  Decimal @db.Decimal(4, 1)

  extractedCompsGrid Json

  isHumanVerified  Boolean   @default(false)
  verifiedAt       DateTime? @db.Timestamptz
  verifiedByUserId String?   @db.Uuid
  verifiedByUser   User?     @relation("AppraisalVerifiedByUser", fields: [tenantId, verifiedByUserId], references: [tenantId, id], onDelete: Restrict)

  actionItems AppraisalActionItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([tenantId, id])
  @@index([tenantId, loanId])
  @@map("appraisal_audits")
}

model AppraisalActionItem {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @db.Uuid
  appraisalAuditId String         @db.Uuid
  appraisalAudit   AppraisalAudit @relation(fields: [tenantId, appraisalAuditId], references: [tenantId, id], onDelete: Cascade)

  code            String          @db.VarChar(100)
  category        ActionCategory  @default(REPAIR)
  severity        RuleSeverity    @default(CRITICAL_ERROR)
  description     String          @db.Text
  sourceAuthority AuthoritySource @default(FHA_HUD_4000_1)

  coordinates Json?

  autoPrefillNovConditionText String? @db.Text

  isCleared       Boolean   @default(false)
  clearedAt       DateTime? @db.Timestamptz
  clearedByUserId String?   @db.Uuid
  clearedByUser   User?     @relation("ActionItemClearedByUser", fields: [tenantId, clearedByUserId], references: [tenantId, id], onDelete: Restrict)
  clearedNotes    String?   @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([tenantId, appraisalAuditId, isCleared])
  @@map("appraisal_action_items")
}
