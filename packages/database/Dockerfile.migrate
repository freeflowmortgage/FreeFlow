# syntax=docker/dockerfile:1
FROM cgr.dev/chainguard/node@sha256:8e8d45dd674724ccc71aed270223c3e2efc74edde6c841158d618d2baaaf5527 AS builder

USER root
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN apk add --no-cache openssl=3.6.5-r6 \
    && corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/database/package.json ./packages/database/
RUN --mount=type=cache,id=freeflow-pnpm-migration,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --filter @mortgage-pos/database...

COPY packages/database/prisma ./packages/database/prisma
COPY packages/database/scripts/migrate-live-test.sh /usr/local/bin/freeflow-migrate

# The repository is used from Windows as well as Linux. Normalize the copied
# shell entrypoint so its /bin/sh shebang is executable in the Linux runtime.
RUN sed -i 's/\r$//' /usr/local/bin/freeflow-migrate

RUN pnpm --filter @mortgage-pos/database prisma:generate \
    && chmod 0555 /usr/local/bin/freeflow-migrate

FROM cgr.dev/chainguard/wolfi-base@sha256:be019c1c74fe69204a42c4e10bc4d886a49bf5403ffa74374ef7baa408fc9a26 AS runner

RUN apk add --no-cache \
        nodejs-26=26.13.1-r1 \
        openssl=3.6.5-r6 \
        postgresql-19-client=19.0-r0 \
    && ldconfig \
    && addgroup -S -g 1001 nodejs \
    && adduser -S -D -h /home/appuser -s /bin/false -G nodejs -u 1001 appuser \
    && mkdir -p /home/appuser /tmp/freeflow \
    && chown -R appuser:nodejs /home/appuser /tmp/freeflow

COPY --from=builder --chown=appuser:nodejs /app /app
COPY --from=builder /usr/local/bin/freeflow-migrate /usr/local/bin/freeflow-migrate

ENV HOME="/home/appuser"
ENV TMPDIR="/tmp/freeflow"

USER appuser
WORKDIR /app/packages/database

ENTRYPOINT ["/usr/local/bin/freeflow-migrate"]
