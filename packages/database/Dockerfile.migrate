# syntax=docker/dockerfile:1
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN apk add --no-cache openssl postgresql-client \
    && corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/database/package.json ./packages/database/
RUN --mount=type=cache,id=freeflow-pnpm-migration,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --filter @mortgage-pos/database...

COPY packages/database/prisma ./packages/database/prisma
COPY packages/database/scripts/migrate-live-test.sh /usr/local/bin/freeflow-migrate

# The repository is used from Windows as well as Linux. Normalize the copied
# shell entrypoint so its /bin/sh shebang is executable in the Linux runtime.
RUN sed -i 's/\r$//' /usr/local/bin/freeflow-migrate

RUN pnpm --filter @mortgage-pos/database prisma:generate \
    && addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 --ingroup nodejs --shell /bin/false appuser \
    && mkdir -p /tmp/freeflow \
    && chown -R appuser:nodejs /app /tmp/freeflow \
    && chmod 0555 /usr/local/bin/freeflow-migrate

RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /root/.cache/node/corepack /pnpm \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
        /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg

ENV HOME="/tmp/freeflow"
ENV TMPDIR="/tmp/freeflow"

USER appuser
WORKDIR /app/packages/database

ENTRYPOINT ["/usr/local/bin/freeflow-migrate"]
