# syntax=docker/dockerfile:1
FROM node:22-trixie-slim

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl postgresql-client \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/database/package.json ./packages/database/
RUN pnpm install --frozen-lockfile --filter @mortgage-pos/database...

COPY packages/database/prisma ./packages/database/prisma
COPY packages/database/scripts/migrate-live-test.sh /usr/local/bin/freeflow-migrate

RUN pnpm --filter @mortgage-pos/database prisma:generate \
    && groupadd --system --gid 1001 nodejs \
    && useradd --system --uid 1001 --gid nodejs --shell /usr/sbin/nologin appuser \
    && mkdir -p /tmp/freeflow \
    && chown -R appuser:nodejs /app /tmp/freeflow \
    && chmod 0555 /usr/local/bin/freeflow-migrate

ENV HOME="/tmp/freeflow"
ENV TMPDIR="/tmp/freeflow"

USER appuser
WORKDIR /app/packages/database

ENTRYPOINT ["/usr/local/bin/freeflow-migrate"]
