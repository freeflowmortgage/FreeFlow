# FreeFlow production configuration contract.
#
# This file is safe to commit because it contains no credentials. Do not copy a
# populated .env.production into an image or source control. In Amazon ECS,
# provide non-secret values through the task definition `environment` section
# and inject secret values from AWS Secrets Manager or SSM Parameter Store
# through the task definition `secrets` section.

# Runtime (non-secret)
NODE_ENV=production
FREEFLOW_RUNTIME_ENV=production
PORT=3001
APP_BASE_URL=https://app.example.com
TRUSTED_ORIGIN=https://app.example.com
AWS_REGION=us-east-1
LOG_LEVEL=info

# Internal service discovery (non-secret; private DNS names only)
DOC_PARSER_URL=http://income-parser.freeflow.local:8080/api/underwrite/process
DOC_PARSER_SERVICE_URL=http://income-parser.freeflow.local:8080/parse
APPRAISAL_PARSER_URL=http://appraisal-parser.freeflow.local:8081

# Authentication (issuer/audience are non-secret)
OIDC_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE
OIDC_CLIENT_ID=replace-with-client-id
OIDC_AUDIENCE=replace-with-audience
ALB_OIDC_SIGNER_ARN=arn:aws:elasticloadbalancing:us-east-1:111122223333:loadbalancer/app/example/example

# Secret values below must be ECS secret references, never literal task values.
DATABASE_URL=secrets-manager:freeflow/production/database-url
DIRECT_URL=secrets-manager:freeflow/production/database-direct-url
REDIS_URL=secrets-manager:freeflow/production/redis-url
ENCOMPASS_CLIENT_ID=secrets-manager:freeflow/production/encompass-client-id
ENCOMPASS_CLIENT_SECRET=secrets-manager:freeflow/production/encompass-client-secret
STRIPE_SECRET_KEY=secrets-manager:freeflow/production/stripe-secret-key
STRIPE_WEBHOOK_SECRET=secrets-manager:freeflow/production/stripe-webhook-secret
FIELD_ENCRYPTION_KEY=secrets-manager:freeflow/production/field-encryption-key

# Queue and integration identifiers (non-secret)
ENCOMPASS_BASE_URL=https://api.elliemae.com
SYNC_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/111122223333/freeflow-production-sync
SYNC_DLQ_URL=https://sqs.us-east-1.amazonaws.com/111122223333/freeflow-production-sync-dlq

# Do not define AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in production.
# ECS task roles supply short-lived AWS credentials.
