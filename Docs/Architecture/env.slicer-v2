# ==============================================================================
# FREEFLOW INCOME ENGINE - VOLATILE DOCUMENT PROCESSING CONTAINER ENVIRONMENT
# ==============================================================================
# This environment file is strictly scoped to the containerized Python/FastAPI
# document slicing and coordinate mapping microservice. 
# 
# IMPORTANT: This service is fully stateless and runs in-memory. It has zero 
# connections to the PostgreSQL database, Stripe billing hooks, NextAuth auth loops,
# or Ellie Mae Encompass API endpoints (which are handled entirely by the Node.js/Next.js POS portal).
# ==============================================================================

# 1. Container Runtime Configuration
ENV="production"
PORT=8080
PYTHONUNBUFFERED=1

# 2. Local File Safety MIME Validation
# Enabled system mime-type checking via libmagic
MIME_CHECK_ENABLED=true

# 3. Microservice Network Bounds
# Restrict FastAPI loopback binding
ALLOWED_HOSTS="0.0.0.0"

# 4. Local OCR Language Training Base
TESSDATA_PREFIX="/usr/share/tesseract-ocr/5/tessdata/"
