# ==============================================================================
# FREEFLOW B2B MONOREPO - LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Save this file in your root monorepo directory as '.env.development'
# This file is auto-generated and synced with the latest merged PRs (#5, #7)
# 
# SETUP:
#   1. Copy this file: cp .env.development .env
#   2. Boot docker services: docker compose up -d
#   3. Start dev server: pnpm dev
# ==============================================================================

# 1. System Runtime Node Settings
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
HOST=0.0.0.0

# 2. Document Parser Services (PR #7: Independent FastAPI microservices)
# Income document parser (W-2, Schedule C/E/F, K-1s, Form 1120-S/1065)
DOC_PARSER_URL="http://localhost:8080"
DOC_PARSER_SERVICE_URL="http://localhost:8080"

# Appraisal parser and agency rules engine (URAR 1004, FHA/VA/USDA/GSE reviews)
APPRAISAL_PARSER_URL="http://localhost:8081"

# 3. B2B Decoupled PostgreSQL Connection Strings (Matches docker-compose Postgres)
# User: postgres | Password: localpassword123 | Database: freeflow_dev | Port: 5432
DATABASE_URL="postgresql://postgres:localpassword123@localhost:5432/freeflow_dev?schema=public"
DIRECT_URL="postgresql://postgres:localpassword123@localhost:5432/freeflow_dev?schema=public"

# 4. Redis Volatile Cache & Task Queue (Matches docker-compose Redis)
# Port: 6379 | Used for background Encompass eFolder operations
REDIS_URL="redis://localhost:6379"

# 5. Local S3 / MinIO Private Document Storage (Matches docker-compose MinIO)
# Used to stage PDFs during in-memory slicing and Schedule E dual-monitor sync
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="localminioadmin"
AWS_SECRET_ACCESS_KEY="localminiopassword123"
AWS_S3_ENDPOINT="http://localhost:9000"
AWS_S3_BUCKET_NAME="freeflow-document-intake"

# 6. Cryptographic & Security Tokens (Local development - non-prod keys)
# Used for SHA-256 document deduplication and JWT auth
CRYPTO_SALT_SECRET="7a6d8f8d6e3e5b3c4f9a0c2e1f4b8d2c"
JWT_SECRET="9b2c8d2c4f9a0c2e1f4b8d2c7a6d8f8d"
NEXTAUTH_SECRET="e1f4b8d2c7a6d8f8d9b2c8d2c4f9a0c2"

# 7. Encompass REST Gateway Integration (Ellie Mae Mock)
# Used to sync rental income (Schedule E), K-1 minority rules, and Form 1084 calcs
ENCOMPASS_CLIENT_ID="mock_encompass_client_id_456"
ENCOMPASS_CLIENT_SECRET="mock_encompass_secret_789"
ENCOMPASS_INSTANCE_ID="mock_instance_001"
ENCOMPASS_BASE_URL="http://localhost:3000/api/mock/encompass"

# 8. Stripe Test Keys (Volumetric transaction fee audit)
STRIPE_SECRET_KEY="sk_test_mock_stripe_secret_key_123"
STRIPE_WEBHOOK_SECRET="whsec_mock_webhook_secret_123"

# 9. Volumetric Transaction Fee Baselines (Tier-Based Default settings)
NEXT_PUBLIC_WAGE_EARNER_FEE_CENTS=800     # Tier 1: $8.00 standard W-2 run
NEXT_PUBLIC_SINGLE_PROP_FEE_CENTS=2500    # Tier 2: $25.00 single Schedule C/E rental
NEXT_PUBLIC_MULTI_ENTITY_FEE_CENTS=4500   # Tier 3: $45.00 complex S-Corp/Partnership analysis

# 10. Feature Flags & Debug Options (PR #5: Rental Income & Dual-Monitor)
# Enable Schedule E tab and dual-monitor BroadcastChannel sync
NEXT_PUBLIC_ENABLE_SCHEDULE_E=true
NEXT_PUBLIC_ENABLE_DUAL_MONITOR=true
NEXT_PUBLIC_ENABLE_K1_MINORITY_RULES=true

# Enable mobile tap-to-speak voice intake (PR #7: Mobile UX)
NEXT_PUBLIC_ENABLE_VOICE_INTAKE=true

# Parser health check timeout (ms) - increase if behind slow network
PARSER_HEALTH_CHECK_TIMEOUT_MS=1200
